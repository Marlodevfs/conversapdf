# ConversaPDF environment variables (all server-side)

# Polar (one-time purchase per conversation)
# Organization access token, scopes: checkouts:write, checkouts:read, products:read
POLAR_ACCESS_TOKEN=
# Product IDs of the three one-time products
POLAR_PRODUCT_TEXT=
POLAR_PRODUCT_PHOTOS=
POLAR_PRODUCT_PROOF=
# Optional: "sandbox" to test with sandbox.polar.sh
POLAR_SERVER=
