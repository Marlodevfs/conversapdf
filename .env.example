# ConversaPDF environment variables
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Paddle (one-time purchase per conversation). Sandbox values start with test_ / contain sdbx.
# Public (browser):
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_PRICE_TEXT=
NEXT_PUBLIC_PADDLE_PRICE_PHOTOS=
NEXT_PUBLIC_PADDLE_PRICE_PROOF=
# Secret (server only), used to verify that a transaction is paid:
PADDLE_API_KEY=
# Optional: sandbox | production (guessed from the API key otherwise)
PADDLE_ENVIRONMENT=
